# =============================================================
# ENVIRONMENT CONFIGURATION - SOCIAL NETWORK RECOMMENDATION SYSTEM
# =============================================================

# Flask Secret Key for sessions and flash messaging
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Flask Environment (development / production)
FLASK_ENV=production

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# For Local Development:
# Leave blank to automatically use local SQLite database (social_network.db)
# Or specify a custom SQLite file path:
# DATABASE_PATH=social_network.db

# For Production (Vercel / Cloud):
# Provide a connection string to a managed PostgreSQL database (e.g., Neon PostgreSQL, Supabase):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
