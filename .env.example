# Copy to .env for local use (never commit .env). On Vercel, set these in Project Settings > Environment Variables.

# Production: PostgreSQL connection string (e.g. from Neon). Leave unset locally to use SQLite.
DATABASE_URL=

# Long random string used to sign session cookies / CSRF tokens.
SECRET_KEY=

# Optional: local SQLite file location (default: data/network.db)
SQLITE_PATH=
